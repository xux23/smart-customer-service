# ===== LLM 配置 =====
# openai = 真实接口（OpenAI 兼容协议）；mock = 关键词规则模拟，离线可跑
LLM_PROVIDER=openai

# 常用服务商对照（改这两项即换厂商）：
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4          glm-4-flash
#   DeepSeek:  https://api.deepseek.com                       deepseek-chat
#   阿里通义:  https://dashscope.aliyuncs.com/compatible-mode/v1  qwen-plus
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# ===== 业务阈值 =====
# 意图置信度低于该值转人工
INTENT_CONFIDENCE_THRESHOLD=0.6
# 检索最高相似度 >= 该值直接回答
KB_MATCH_THRESHOLD=0.55
# 最高相似度在 [KB_SIMILAR_THRESHOLD, KB_MATCH_THRESHOLD) 区间返回相似问题列表
KB_SIMILAR_THRESHOLD=0.30
# 降级时返回的相似问题数量
KB_TOP_N=3

# ===== 存储 =====
KB_PATH=app/data/knowledge.json
DB_PATH=tickets.db
